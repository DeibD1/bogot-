{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run web:build",
  "outputDirectory": "dist-web",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/alertas", "schedule": "0 13 * * *" }]
}
