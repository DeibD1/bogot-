+    /* Tema oscuro institucional: grafito azulado + acento dorado. */
+    --background: 222 30% 7%;
+    --foreground: 220 25% 94%;
+    --card: 222 26% 11%;
+    --card-foreground: 220 25% 94%;
+    --primary: 42 66% 51%;
+    --primary-foreground: 222 40% 9%;
+    --secondary: 222 22% 16%;
+    --secondary-foreground: 220 25% 94%;
+    --muted: 222 22% 15%;
+    --muted-foreground: 220 12% 63%;
+    --accent: 176 45% 48%;
+    --accent-foreground: 222 40% 9%;
+    --destructive: 0 78% 63%;
+    --destructive-foreground: 220 25% 97%;
+    --border: 222 20% 20%;
+    --input: 222 20% 18%;
+    --ring: 42 66% 51%;
