     }
   }
 }
+
+/** Crea el mailer disponible: Resend si hay API key, si no SMTP, si no null. */
+export function crearMailer(config: ConfigApp): Mailer | null {
+  return crearMailerResend() ?? crearMailerSmtp(config)
+}
